# Delta Exchange credentials (only required for live trading on Delta)
# Create from https://www.delta.exchange/app/account/manage/api
DELTA_API_KEY=
DELTA_API_SECRET=

# Delta endpoints (defaults are the global deployment; use india.* for IN region)
DELTA_BASE_URL=https://api.delta.exchange
DELTA_WS_URL=wss://socket.delta.exchange

# Optional: if set, the bot calls Delta's change-leverage endpoint at startup
# so its assumed margin math matches the account setting. Leave blank to use
# whatever you've configured in the Delta UI.
DELTA_LEVERAGE=100

# Bot configuration overrides (optional; otherwise from config/config.yaml)
BOT_BANKROLL=27.0
BOT_KELLY_FRACTION=0.25

# Sizing knobs (leverage-aware: applied against bankroll * leverage on perps).
# With DELTA_LEVERAGE=50 and BOT_BANKROLL=20:
#   trade_size_fraction = 0.5 → target = 50% of (20 * 50) = $500 notional
#                               per Delta trade (~50 contracts of $10 perps)
#   max_trade_fraction  = 0.5 → ceiling clamp on the largest leg
# Set both to a smaller fraction (e.g. 0.10) for more conservative sizing.
BOT_TRADE_SIZE_FRACTION=0.5
BOT_MAX_TRADE_FRACTION=0.5
BOT_PAPER=true
BOT_LOG_LEVEL=INFO
